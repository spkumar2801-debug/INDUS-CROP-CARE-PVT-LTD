rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isSuperAdminEmail() {
      return isAuthenticated() && 
             request.auth.token.email != null &&
             request.auth.token.email.lower() in [
               'admin@induscropcare.com', 
               'info@induscropcare.com',
               'indusagriseedspl@gmail.com'
             ];
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdminEmail() ||
        request.auth.token.admin == true ||
        (firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid)) &&
         (!('disabled' in firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data) ||
          firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.disabled != true) &&
         ('role' in firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data) &&
         firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.role in ['admin', 'superadmin', 'editor'])
      );
    }

    // Public branding, products, and gallery media are readable by everyone
    // Uploads strictly restricted to verified Admins with MIME type and size checks
    match /{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
                           && request.resource.size < 25 * 1024 * 1024
                           && (request.resource.contentType.matches('image/.*') || 
                               request.resource.contentType.matches('video/mp4') ||
                               request.resource.contentType.matches('video/webm') ||
                               request.resource.contentType.matches('application/pdf'));
      allow delete: if isAdmin();
    }
  }
}
